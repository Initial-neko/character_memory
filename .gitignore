__pycache__/
.pytest_cache/
.pytest-tmp/
*.pyc
*.egg-info/
.venv/
.venv-cosyvoice/
.venv-qwen3-tts/
.external/
data/*.db
data/qwen3-tts-benchmark/
models/
config.yaml
config.yaml.bak.*
.env

# Frozen voice assets are local data. A VoiceDesign clip cannot be regenerated
# from its prompt (the sidecar is unseeded), so the WAV is an asset, not build
# output. The character's voice.yaml is *not* ignored alongside it: it only ever
# names a template now, which is configuration -- see the voices/ rule below.
personas/*/voice/
# Creation provenance may contain the user's original prompt and is runtime data.
personas/*/creation.json
# Characters created at runtime through the app are local data too.
personas/character-*/
# Voice templates own the reference clips; they are local assets, not source.
# personas/<id>/voice.yaml stays tracked -- that is configuration, not audio.
# A runtime-created character-* directory above is local data wholesale, so a
# voice.yaml inside one of those stays ignored along with the rest of it.
voices/
