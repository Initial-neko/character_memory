# Copy to .env for local secrets. System environment variables override these values.
# Settings Center :8003 can create/update this file without exposing existing values.
OPENCODE_GO_API_KEY=
EMBEDDING_API_KEY=
SEARCHAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
AGNES_API_KEY=
# MSIMG_API_KEY takes precedence; MODELSCOPE_API_TOKEN remains accepted for compatibility.
MSIMG_API_KEY=
MODELSCOPE_API_TOKEN=
# Optional for model download rate limits.
HF_TOKEN=


# GSV-TTS-Lite runtime assets. These are local runtime configuration, not
# secrets, but live in .env so config.yaml remains only the formal TTS selector.
# Settings Center can create/update these fields without replacing other values.
GSV_TTS_GPT_MODEL=
GSV_TTS_SOVITS_MODEL=
GSV_TTS_REF_AUDIO=
GSV_TTS_REF_TEXT=
GSV_TTS_VOICE=murasame
